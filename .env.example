# --- سرور ---
NODE_ENV=production
PORT=3102
HOST=127.0.0.1
TRUST_PROXY=true

# --- دیتابیس PostgreSQL ---
DATABASE_URL=postgres://nezarat:CHANGE_ME@127.0.0.1:5432/nezarat

# --- نشست (حداقل ۳۲ کاراکتر تصادفی: openssl rand -base64 48) ---
SESSION_SECRET=
SESSION_TTL_HOURS=12
COOKIE_SECURE=true

# --- فایل‌ها (خارج از webroot) ---
UPLOAD_DIR=/var/lib/nezarat/uploads

# --- پیامک: kavenegar | melipayamak | ippanel  (mock فقط در توسعه) ---
SMS_PROVIDER=kavenegar
SMS_WEBHOOK_TOKEN=

# --- OTP ---
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_MAX_PER_MOBILE_10MIN=3
OTP_MAX_PER_IP_10MIN=10

# --- فقط برای seed ادمین (اختیاری؛ در غیر این صورت prompt) ---
# ADMIN_PASSWORD=

# --- تست‌های یکپارچه (دیتابیس جداگانه؛ پاک می‌شود!) ---
# TEST_DATABASE_URL=postgres://postgres:pw@127.0.0.1:5432/nezarat_test
