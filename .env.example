# --- سرور ---
NODE_ENV=production
PORT=3102
HOST=127.0.0.1
TRUST_PROXY=true
# فقط از این IPها X-Forwarded-Host/For پذیرفته می‌شود (nginx روی همین سرور)
TRUSTED_PROXY_IPS=127.0.0.1,::1
# دامنهٔ دانشگاه شمال؛ seed-base آن را روی tenant «shomal» تنظیم می‌کند
TENANT_HOSTNAME=nezarat.shomal.ac.ir

# --- دیتابیس PostgreSQL ---
DATABASE_URL=postgres://nezarat:CHANGE_ME@127.0.0.1:5432/nezarat

# --- نشست (حداقل ۳۲ کاراکتر تصادفی: openssl rand -base64 48) ---
SESSION_SECRET=
SESSION_TTL_HOURS=12
COOKIE_SECURE=true

# --- فایل‌ها (خارج از webroot) ---
UPLOAD_DIR=/var/lib/nezarat/uploads

# --- پیامک: kavenegar | melipayamak | ippanel  (mock فقط در توسعه) ---
SMS_PROVIDER=kavenegar
# توکن تصادفی webhook (openssl rand -hex 24) — ترجیحاً در هدر X-Webhook-Token، وگرنه ?token=
SMS_WEBHOOK_TOKEN=

# کاوه‌نگار (OTP با verify/lookup و نام الگو)
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=

# ملی‌پیامک / فراپیامک (OTP با BaseServiceNumber و bodyId الگو)
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_SENDER=
MELIPAYAMAK_OTP_BODY_ID=

# IPPanel / فراز اس‌ام‌اس (OTP با pattern code)
IPPANEL_API_KEY=
IPPANEL_SENDER=
IPPANEL_OTP_PATTERN=

# --- ایمیل SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="سامانه جذب اساتید <no-reply@shomal.ac.ir>"

# --- worker ---
WORKER_POLL_MS=2000
WORKER_BATCH=10
WORKER_STALE_MINUTES=10
MAX_UPLOAD_MB=10

# --- OTP ---
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_MAX_PER_MOBILE_10MIN=3
OTP_MAX_PER_IP_10MIN=10

# --- فقط برای seed ادمین (اختیاری؛ در غیر این صورت prompt) ---
# ADMIN_PASSWORD=

# --- تست‌های یکپارچه (دیتابیس جداگانه؛ پاک می‌شود!) ---
# TEST_DATABASE_URL=postgres://postgres:pw@127.0.0.1:5432/nezarat_test
