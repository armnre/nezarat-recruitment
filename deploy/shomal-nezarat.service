[Unit]
Description=Nezarat recruitment API (Fastify, port 3102)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=nezarat
Group=nezarat
WorkingDirectory=/opt/nezarat/apps/api
EnvironmentFile=/etc/nezarat/nezarat.env
Environment=NODE_ENV=production
Environment=PORT=3102
ExecStart=/usr/bin/env node dist/server.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/nezarat

[Install]
WantedBy=multi-user.target
