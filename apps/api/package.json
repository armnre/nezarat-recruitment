{
  "name": "@nezarat/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/cli/migrate.js",
    "seed:admin": "node dist/cli/seed-admin.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "10.3.0",
    "@nezarat/shared": "1.0.0",
    "argon2": "0.41.1",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.36.4",
    "fastify": "5.12.7",
    "fastify-plugin": "5.1.0",
    "nodemailer": "6.9.16",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "sharp": "0.33.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "6.4.17",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.28.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
